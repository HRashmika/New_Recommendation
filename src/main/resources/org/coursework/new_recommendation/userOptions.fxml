<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"  style="-fx-background-color: #E0B0FF; " styleClass="anchor-pane-background" stylesheets="@../../../CSS/articles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.coursework.new_recommendation.App.UserOptions">
    <children>
        <Button fx:id="recommendationsButton" layoutX="38.0" layoutY="160.0" mnemonicParsing="false" onAction="#handleRecommendationsButtonAction" style="-fx-background-radius: 10;" text="Recommendations" />

        <Button fx:id="likeArticleButton" layoutX="48.0" layoutY="212.0" mnemonicParsing="false" onAction="#handleLikeArticleButtonAction" style="-fx-background-radius: 10;" text="Liked Articles" />
        <Button fx:id="profileButton" layoutX="66.0" layoutY="262.0" mnemonicParsing="false" onAction="#handleProfileButtonAction" style="-fx-background-radius: 10;" text="Profile" />
        <Button fx:id="articlesButton" layoutX="68.0" layoutY="107.0" mnemonicParsing="false" onAction="#handleArticlesButtonAction" style="-fx-background-radius: 10;" text="Articles" />

        <StackPane fx:id="contentPane" layoutX="164.0" prefHeight="406.0" prefWidth="658.0" stylesheets="@../../../CSS/articles.css">
            <children>

                <Pane fx:id="articlesPane" prefHeight="378.0" prefWidth="530.0" style="-fx-background-color: #E0B0FF;" visible="false">
                    <children>
                        <HBox alignment="CENTER" layoutX="20.0" layoutY="24.0" prefWidth="490.0" spacing="20.0">
                            <children>
                                <Button fx:id="technologyButton" mnemonicParsing="false" onAction="#handleTechnologyButtonAction" style="-fx-background-radius: 10;" text="Technology" />
                                <Button fx:id="sportsButton" mnemonicParsing="false" onAction="#handleSportsButtonAction" style="-fx-background-radius: 10;" text="Sports" />
                                <Button fx:id="healthButton" mnemonicParsing="false" onAction="#handleHealthButtonAction" style="-fx-background-radius: 10;" text="Health" />
                                <Button fx:id="politicsButton" mnemonicParsing="false" onAction="#handlePoliticsButtonAction" style="-fx-background-radius: 10;" text="Politics" />
                                <Button fx:id="entertainmentButton" mnemonicParsing="false" onAction="#handleEntertainmentButtonAction" style="-fx-background-radius: 10;" text="Entertainment" />
                                <Button fx:id="weatherButton" mnemonicParsing="false" onAction="#handleWeatherButtonAction" style="-fx-background-radius: 10;" text="Weather" />
                            </children>
                        </HBox>
                        <ListView fx:id="articlesListView" layoutX="36.0" layoutY="80.0" prefHeight="303.0" prefWidth="473.0" />
                    </children>
                </Pane>

                <Pane fx:id="likedArticlesPane" prefHeight="378.0" prefWidth="530.0" style="-fx-background-color: #E0B0FF;" visible="false">
                    <children>
                        <VBox alignment="TOP_LEFT" layoutX="20.0" layoutY="20.0" spacing="10.0">
                            <children>
                                <Text style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Liked Articles" />
                                <ListView fx:id="likedArticlesListView" prefHeight="300.0" prefWidth="490.0" />
                            </children>
                        </VBox>
                    </children>
                </Pane>

                <Pane fx:id="profilePane" prefHeight="300.0" prefWidth="600.0" style="-fx-background-color: #E0B0FF;" visible="false">
                    <children>
                        <VBox alignment="CENTER" prefHeight="400" prefWidth="600" spacing="20">
                            <GridPane hgap="10" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" />
                                    <ColumnConstraints hgrow="ALWAYS" />
                           <ColumnConstraints />
                                </columnConstraints>
                                <Label style="-fx-background-radius: 50;" text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <TextField fx:id="usernameField" promptText="Enter new username" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label style="-fx-background-radius: 50;" text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <TextField fx:id="emailField" promptText="Enter new email" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label style="-fx-background-radius: 50;" text="Preferences:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <TextField fx:id="preferencesField" promptText="Enter preferences" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label style="-fx-background-radius: 50;" text="New Password:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <TextField fx:id="newPasswordField" promptText="Enter new password" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                <Label style="-fx-background-radius: 50;" text="Confirm Password:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                <TextField fx:id="confirmPasswordField" promptText="Confirm new password" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                <Button onAction="#handleUpdateAllFieldsAction" style="-fx-background-radius: 10;" text="Update All Fields" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                                <rowConstraints>
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                           <RowConstraints />
                           <RowConstraints />
                           <RowConstraints />
                                </rowConstraints>
                            </GridPane>

                            <TableView fx:id="loginTimesTableView" layoutX="100.0" layoutY="100.0" prefHeight="287.0" prefWidth="300.0">
                                <columns>
                                    <TableColumn fx:id="loginTimeColumn" prefWidth="300.0" text="Login Times">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="loginTime" />
                                        </cellValueFactory>
                                    </TableColumn>
                                </columns>
                            </TableView>

                        </VBox>

                    </children>
                </Pane>

                <Pane fx:id="articleDetailsPane" prefHeight="378.0" prefWidth="530.0" style="-fx-background-color: #E0B0FF;" visible="false">
                    <children>
                        <VBox fx:id="articleDetailsVBox" layoutX="20.0" layoutY="24.0" prefWidth="490.0" spacing="20.0">

                            <HBox spacing="10.0">
                                <Label style="-fx-background-radius: 50;" text="Headline:" />
                                <Text fx:id="headlineText" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                            </HBox>

                            <HBox spacing="10.0">
                                <Label style="-fx-background-radius: 50;" text="Description:" />
                                <TextArea fx:id="descriptionText" editable="false" prefHeight="150.0" prefWidth="400.0" wrapText="true" />
                            </HBox>

                            <HBox spacing="10.0">
                                <Label style="-fx-background-radius: 50;" text="Authors:" />
                                <Text fx:id="authorsText" />
                            </HBox>

                            <HBox spacing="10.0">
                                <Label style="-fx-background-radius: 50;" text="Date:" />
                                <Text fx:id="dateText" />
                            </HBox>

                            <HBox spacing="10.0">
                                <Label style="-fx-background-radius: 50;" text="Link:" />
                                <Text fx:id="linkText" />
                            </HBox>

                            <HBox alignment="CENTER" spacing="10.0">
                                <Button fx:id="likeButton" mnemonicParsing="false" onAction="#handleLikeAction" style="-fx-background-radius: 10;" text="Like" />
                                <Button fx:id="dislikeButton" mnemonicParsing="false" onAction="#handleDislikeAction" style="-fx-background-radius: 10;" text="Dislike" />
                                <Button fx:id="openLinkButton" mnemonicParsing="false" onAction="#handleOpenArticle" style="-fx-background-radius: 10;" text="Link" />

                            </HBox>
                        </VBox>
                    </children>
                </Pane>

                <Pane fx:id="recommendationsPane" style="-fx-background-color: #E0B0FF;" visible="false">
                    <TableView fx:id="articlesTableView" layoutX="106.0" layoutY="66.0" prefHeight="323.0" prefWidth="414.0">
                        <columns>
                            <TableColumn fx:id="headlineColumn" prefWidth="260.0" text="Headline" />
                            <TableColumn fx:id="categoryColumn" minWidth="0.0" prefWidth="0.0" text="Category" />
                        </columns>
                    </TableView>


                </Pane>



            </children>
        </StackPane>
        <Button fx:id="logoutbutton" layoutX="66.0" layoutY="350.0" mnemonicParsing="false" onAction="#handleLogOutButton" style="-fx-background-radius: 10;" text="Log Out" />

        <Line endX="32.99998474121094" endY="-3.0517578125E-5" layoutX="115.0" layoutY="316.0" startX="-100.0" stroke="WHITE" />
    </children>
</AnchorPane>

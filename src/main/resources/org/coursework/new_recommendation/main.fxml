<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.coursework.new_recommendation.MainApplication">
    <children>
        <!-- User Pane -->
        <Pane layoutY="95.0" prefHeight="117.0" prefWidth="606.0">
            <children>
                <Button fx:id="UserloginButton" layoutX="325.0" layoutY="67.0" mnemonicParsing="false" text="Login" onAction="#handleUserLoginButtonAction" />
                <Button fx:id="signUpButton" layoutX="183.0" layoutY="67.0" mnemonicParsing="false" text="Sign Up" onAction="#handleUserSignUpButtonAction" />
                <Text layoutX="267.0" layoutY="42.0" strokeType="OUTSIDE" strokeWidth="0.0" text="User">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Text>
            </children>
        </Pane>
        <!-- Admin Pane -->
        <Pane layoutY="255.0" prefHeight="131.0" prefWidth="606.0">
            <children>
                <Button fx:id="loginButton" layoutX="259.0" layoutY="66.0" mnemonicParsing="false" text="Login" onAction="#handleLoginButtonAction" />
                <Text layoutX="228.0" layoutY="46.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Administrator">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Text>
            </children>
        </Pane>
    </children>
</AnchorPane>

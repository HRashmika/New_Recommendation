<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefHeight="604.0" prefWidth="750.0" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.coursework.new_recommendation.SignUp">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <!-- Error Message Label -->
   <Label fx:id="errorMessageLabel" textFill="red" visible="false" />

   <AnchorPane prefHeight="529.0" prefWidth="712.0">
      <children>
         <Text layoutX="287.0" layoutY="52.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Sign Up " textAlignment="CENTER">
            <font>
               <Font size="24.0" />
            </font>
         </Text>

         <Text layoutX="86.0" layoutY="101.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Email" />
         <Text layoutX="86.0" layoutY="146.0" strokeType="OUTSIDE" strokeWidth="0.0" text="User Name" />
         <TextField fx:id="emailTextField" layoutX="186.0" layoutY="83.0" prefHeight="26.0" prefWidth="401.0" />
         <TextField fx:id="userNameTextField" layoutX="186.0" layoutY="128.0" prefHeight="26.0" prefWidth="310.0" />

         <!-- PasswordField for password -->
         <Text layoutX="86.0" layoutY="193.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Password" />
         <PasswordField fx:id="passwordTextField" layoutX="186.0" layoutY="176.0" prefHeight="26.0" prefWidth="253.0" />

         <Text layoutX="86.0" layoutY="227.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Confirm Password" />
         <PasswordField fx:id="confirmPasswordTextField" layoutX="186.0" layoutY="218.0" prefHeight="26.0" prefWidth="254.0" />

         <Text layoutX="82.0" layoutY="291.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Preferences" />
         <CheckBox fx:id="techCheckBox" layoutX="186.0" layoutY="278.0" text="Technology" />
         <CheckBox fx:id="aiCheckBox" layoutX="299.0" layoutY="278.0" text="AI" />
         <CheckBox fx:id="weatherCheckBox" layoutX="376.0" layoutY="278.0" text="Weather" />
         <CheckBox fx:id="healthcareCheckBox" layoutX="481.0" layoutY="278.0" text="Healthcare" />
         <CheckBox fx:id="sportsCheckBox" layoutX="186.0" layoutY="321.0" text="Sports" />
         <CheckBox fx:id="financeCheckBox" layoutX="299.0" layoutY="321.0" text="Finance" />

         <Line endX="270.60003662109375" endY="3.0517578125E-5" layoutX="335.0" layoutY="409.0" startX="-263.0" startY="3.0517578125E-5" />
         <Text layoutX="273.0" layoutY="436.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Already have an account" />

         <!-- Buttons for login and sign-up -->
         <Button fx:id="backButton" layoutX="21.0" layoutY="14.0" text="Back" onAction="#handleBackButtonAction"/>
         <Button fx:id="signupButton" layoutX="293.0" layoutY="356.0" text="Signup" onAction="#handleSignUpButtonAction" prefHeight="26.0" prefWidth="83.0" />
         <Button fx:id="loginButton" layoutX="312.0" layoutY="457.0" text="Login" onAction="#handleLoginButtonAction"/>
      </children>
   </AnchorPane>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.coursework.new_recommendation.SignUp" prefHeight="604.0" prefWidth="750.0">
   <children>
      <Label fx:id="errorMessageLabel" layoutX="20.0" layoutY="20.0" textFill="red" visible="false" />
      <Text layoutX="287.0" layoutY="52.0" text="Sign Up" textAlignment="CENTER">
         <font>
            <Font size="24.0" />
         </font>
      </Text>
      <Text layoutX="86.0" layoutY="101.0" text="Email" />
      <TextField fx:id="emailTextField" layoutX="186.0" layoutY="83.0" prefHeight="26.0" prefWidth="401.0" />
      <Text layoutX="86.0" layoutY="146.0" text="User Name" />
      <TextField fx:id="userNameTextField" layoutX="186.0" layoutY="128.0" prefHeight="26.0" prefWidth="401.0" />
      <Text layoutX="86.0" layoutY="193.0" text="Password" />
      <PasswordField fx:id="passwordTextField" layoutX="186.0" layoutY="176.0" prefHeight="26.0" prefWidth="401.0" />
      <Text layoutX="86.0" layoutY="227.0" text="Confirm Password" />
      <PasswordField fx:id="confirmPasswordTextField" layoutX="186.0" layoutY="218.0" prefHeight="26.0" prefWidth="401.0" />
      <Text layoutX="86.0" layoutY="275.0" text="Preferences" />
      <CheckBox fx:id="techCheckBox" layoutX="186.0" layoutY="260.0" text="Technology" />
      <CheckBox fx:id="aiCheckBox" layoutX="300.0" layoutY="260.0" text="AI" />
      <CheckBox fx:id="weatherCheckBox" layoutX="400.0" layoutY="260.0" text="Weather" />
      <CheckBox fx:id="healthcareCheckBox" layoutX="186.0" layoutY="300.0" text="Healthcare" />
      <CheckBox fx:id="sportsCheckBox" layoutX="300.0" layoutY="300.0" text="Sports" />
      <CheckBox fx:id="financeCheckBox" layoutX="400.0" layoutY="300.0" text="Finance" />
      <Button fx:id="signupButton" layoutX="310.0" layoutY="350.0" text="Signup" onAction="#handleSignUpButtonAction" />
      <Button fx:id="backButton" layoutX="20.0" layoutY="20.0" text="Back" onAction="#handleBackButtonAction" />
      <Text layoutX="310.0" layoutY="400.0" text="Already have an account?" />
      <Button fx:id="loginButton" layoutX="310.0" layoutY="420.0" text="Login" onAction="#handleLoginButtonAction" />
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.coursework.new_recommendation.Articles">
    <children>
        <TabPane layoutX="3.0" layoutY="3.0" prefHeight="400.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <!-- Home Tab (Empty) -->
                <Tab text="Home">
                    <AnchorPane>
                        <!-- No content in Home tab now -->
                    </AnchorPane>
                </Tab>

                <!-- Articles Tab -->
                <Tab text="Articles">
                    <AnchorPane>
                        <children>
                            <!-- Category Buttons -->
                            <HBox layoutX="10.0" layoutY="10.0" spacing="10.0">
                                <children>
                                    <Button text="Technology" onAction="#showTechnologyArticles"/>
                                    <Button text="Health" onAction="#showHealthArticles"/>
                                    <Button text="Sports" onAction="#showSportsArticles"/>
                                    <Button text="AI" onAction="#showAIArticles"/>
                                </children>
                            </HBox>

                            <!-- ListView to Display Articles -->
                            <ListView fx:id="articlesListView" layoutX="10.0" layoutY="50.0" prefHeight="320.0" prefWidth="580.0"/>
                        </children>
                    </AnchorPane>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>
